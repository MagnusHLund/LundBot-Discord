{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lundbot.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Discord": {
    "Token": "",
    "FastUpdateGuildIds": [""],
    "WebTrafficChannelId": "",
    "ShouldClearGlobalCommands": false,
    "ShouldRegisterGlobalCommands": false
  },
  "Database": {
    "ConnectionString": "Server=x.x.x.x;Port=3306;Database=x;User=x;Password=x;"
  }
}
