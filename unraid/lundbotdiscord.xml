<?xml version="1.0"?>
<Container version="2">
  <Name>LundBot Discord</Name>
  <Repository>local/lundbot</Repository>
  <Registry></Registry>
  <Network>bridge</Network>
  <MyID>lundbot</MyID>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support></Support>
  <Project> LundBot Discord</Project>
  <Overview>LundBot Discord bot running via docker-compose.</Overview>
  <Category>Private</Category>

  <Icon>/plugins/dockerMan/images/lundbot.png</Icon>

  <Config Name="Compose Path" Target="/mnt/user/appdata/LundBot-Discord" Type="Path" Mode="rw" Description="Path to your docker-compose project" Display="always" Required="true" Mask="false">/mnt/user/appdata/LundBot-Discord</Config>

  <Config Name="Environment File" Target="/mnt/user/appdata/LundBot-Discord/.env" Type="Path" Mode="rw" Description="Environment variables" Display="always" Required="true" Mask="false">/mnt/user/appdata/LundBot-Discord/.env</Config>

</Container>
